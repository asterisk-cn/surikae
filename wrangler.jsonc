{
  "name": "surikae",
  "main": "server/room.ts",
  "compatibility_date": "2026-08-01",
  // 独自ドメイン．DNSレコードと証明書はデプロイ時にwranglerが用意する
  "routes": [{ "pattern": "surikae.astrsk.work", "custom_domain": true }],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "durable_objects": {
    "bindings": [{ "name": "ROOM", "class_name": "Room" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }]
}
